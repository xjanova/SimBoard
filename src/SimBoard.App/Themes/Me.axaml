<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Windows ME — generated by .build/gen_themes.py, do not hand-edit -->
  <SolidColorBrush x:Key="Face" Color="#FFD6D3CE" />
  <SolidColorBrush x:Key="Face2" Color="#FFC9C5BF" />
  <SolidColorBrush x:Key="Press" Color="#FFCBC7C1" />
  <SolidColorBrush x:Key="Lite" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Shad" Color="#FF808080" />
  <SolidColorBrush x:Key="Dark" Color="#FF404040" />
  <SolidColorBrush x:Key="RaiseBorderTop" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="RaiseBorderRight" Color="#FF404040" />
  <SolidColorBrush x:Key="RaiseBorderBottom" Color="#FF404040" />
  <SolidColorBrush x:Key="RaiseBorderLeft" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SunkBorderTop" Color="#FF808080" />
  <SolidColorBrush x:Key="SunkBorderRight" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SunkBorderBottom" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SunkBorderLeft" Color="#FF808080" />
  <SolidColorBrush x:Key="TabBorderTop" Color="#FFE6E3DE" />
  <SolidColorBrush x:Key="TabBorderRight" Color="#FF808080" />
  <SolidColorBrush x:Key="TabBorderBottom" Color="#FF808080" />
  <SolidColorBrush x:Key="TabBorderLeft" Color="#FFE6E3DE" />
  <LinearGradientBrush x:Key="TitleBar" StartPoint="0%,50%" EndPoint="100%,50%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF0A246A" Offset="0" />
      <GradientStop Color="#FF2F5F9E" Offset="0.62" />
      <GradientStop Color="#FF8FB7E0" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DialogTitleBar" StartPoint="0%,50%" EndPoint="100%,50%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF0A246A" Offset="0" />
      <GradientStop Color="#FF4F7CB0" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelCaption" StartPoint="0%,50%" EndPoint="100%,50%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF5B7FA8" Offset="0" />
      <GradientStop Color="#FF96B3D0" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Selection" Color="#FF0A246A" />
  <SolidColorBrush x:Key="Frame" Color="#FFD6D3CE" />
  <SolidColorBrush x:Key="FrameBorderTop" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="FrameBorderRight" Color="#FF404040" />
  <SolidColorBrush x:Key="FrameBorderBottom" Color="#FF404040" />
  <SolidColorBrush x:Key="FrameBorderLeft" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TitleBarFg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PanelCaptionFg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="WindowButtonFg" Color="#FF000000" />
  <SolidColorBrush x:Key="MinBg" Color="#FFD6D3CE" />
  <SolidColorBrush x:Key="MinBorderTop" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="MinBorderRight" Color="#FF404040" />
  <SolidColorBrush x:Key="MinBorderBottom" Color="#FF404040" />
  <SolidColorBrush x:Key="MinBorderLeft" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="MaxBg" Color="#FFD6D3CE" />
  <SolidColorBrush x:Key="MaxBorderTop" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="MaxBorderRight" Color="#FF404040" />
  <SolidColorBrush x:Key="MaxBorderBottom" Color="#FF404040" />
  <SolidColorBrush x:Key="MaxBorderLeft" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="CloseBg" Color="#FFD6D3CE" />
  <SolidColorBrush x:Key="CloseBorderTop" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="CloseBorderRight" Color="#FF404040" />
  <SolidColorBrush x:Key="CloseBorderBottom" Color="#FF404040" />
  <SolidColorBrush x:Key="CloseBorderLeft" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="CloseFg" Color="#FF000000" />
  <RadialGradientBrush x:Key="Desktop" Center="30%,0%" GradientOrigin="30%,0%" RadiusX="70%" RadiusY="70%">
    <RadialGradientBrush.GradientStops>
      <GradientStop Color="#FF4D7F97" Offset="0" />
      <GradientStop Color="#FF245A72" Offset="0.45" />
      <GradientStop Color="#FF123A4C" Offset="1" />
    </RadialGradientBrush.GradientStops>
  </RadialGradientBrush>
  <BoxShadows x:Key="RaiseShadow">inset -1 -1 0 0 #FF808080,inset 1 1 0 0 #FFF2EFE9</BoxShadows>
  <BoxShadows x:Key="RaiseShadowLight">inset -1 -1 0 0 #FF808080</BoxShadows>
  <BoxShadows x:Key="SunkShadow">inset 1 1 0 0 #FF404040</BoxShadows>
  <CornerRadius x:Key="ControlRadius">0</CornerRadius>
  <CornerRadius x:Key="WindowRadius">0</CornerRadius>
  <CornerRadius x:Key="WindowButtonRadius">0</CornerRadius>
</ResourceDictionary>
