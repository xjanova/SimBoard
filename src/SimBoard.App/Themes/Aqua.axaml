  <BoxShadows x:Key="RaiseShadow">inset 0 1 0 0 #F2FFFFFF,inset 0 6 6 -6 #FFFFFFFF,inset 0 -7 8 -7 #4714468C,0 1 2 0 #2E143C78</BoxShadows>
