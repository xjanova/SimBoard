<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Macintosh · Platinum — generated by .build/gen_themes.py, do not hand-edit -->
  <SolidColorBrush x:Key="Face" Color="#FFDCDCDC" />
  <SolidColorBrush x:Key="Face2" Color="#FFC8C8C8" />
  <SolidColorBrush x:Key="Press" Color="#FFBDBDBD" />
  <SolidColorBrush x:Key="Lite" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Shad" Color="#FF909090" />
  <SolidColorBrush x:Key="Dark" Color="#FF000000" />
  <SolidColorBrush x:Key="RaiseBorderTop" Color="#FF000000" />
  <SolidColorBrush x:Key="RaiseBorderRight" Color="#FF000000" />
  <SolidColorBrush x:Key="RaiseBorderBottom" Color="#FF000000" />
  <SolidColorBrush x:Key="RaiseBorderLeft" Color="#FF000000" />
  <SolidColorBrush x:Key="SunkBorderTop" Color="#FF5A5A5A" />
  <SolidColorBrush x:Key="SunkBorderRight" Color="#FF5A5A5A" />
  <SolidColorBrush x:Key="SunkBorderBottom" Color="#FF5A5A5A" />
  <SolidColorBrush x:Key="SunkBorderLeft" Color="#FF5A5A5A" />
  <SolidColorBrush x:Key="TabBorderTop" Color="#FF000000" />
  <SolidColorBrush x:Key="TabBorderRight" Color="#FF000000" />
  <SolidColorBrush x:Key="TabBorderBottom" Color="#FF000000" />
  <SolidColorBrush x:Key="TabBorderLeft" Color="#FF000000" />
  <DrawingBrush x:Key="TitleBar" TileMode="Tile" SourceRect="0,0,2,2" DestinationRect="0,0,2,2">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFF2F2F2" Geometry="M0,0 L2,0 L2,1 L0,1 Z" />
        <GeometryDrawing Brush="#FFC4C4C4" Geometry="M0,1 L2,1 L2,2 L0,2 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="DialogTitleBar" TileMode="Tile" SourceRect="0,0,2,2" DestinationRect="0,0,2,2">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFF2F2F2" Geometry="M0,0 L2,0 L2,1 L0,1 Z" />
        <GeometryDrawing Brush="#FFC4C4C4" Geometry="M0,1 L2,1 L2,2 L0,2 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="PanelCaption" TileMode="Tile" SourceRect="0,0,2,2" DestinationRect="0,0,2,2">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFE4E4E4" Geometry="M0,0 L2,0 L2,1 L0,1 Z" />
        <GeometryDrawing Brush="#FFB8B8B8" Geometry="M0,1 L2,1 L2,2 L0,2 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <SolidColorBrush x:Key="Selection" Color="#FF2F5FA8" />
  <SolidColorBrush x:Key="Frame" Color="#FFDCDCDC" />
  <SolidColorBrush x:Key="FrameBorderTop" Color="#FF000000" />
  <SolidColorBrush x:Key="FrameBorderRight" Color="#FF000000" />
  <SolidColorBrush x:Key="FrameBorderBottom" Color="#FF000000" />
  <SolidColorBrush x:Key="FrameBorderLeft" Color="#FF000000" />
  <SolidColorBrush x:Key="TitleBarFg" Color="#FF000000" />
  <SolidColorBrush x:Key="PanelCaptionFg" Color="#FF000000" />
  <SolidColorBrush x:Key="WindowButtonFg" Color="#FF000000" />
  <SolidColorBrush x:Key="MinBg" Color="#FFDCDCDC" />
  <SolidColorBrush x:Key="MinBorderTop" Color="#FF000000" />
  <SolidColorBrush x:Key="MinBorderRight" Color="#FF000000" />
  <SolidColorBrush x:Key="MinBorderBottom" Color="#FF000000" />
  <SolidColorBrush x:Key="MinBorderLeft" Color="#FF000000" />
  <SolidColorBrush x:Key="MaxBg" Color="#FFDCDCDC" />
  <SolidColorBrush x:Key="MaxBorderTop" Color="#FF000000" />
  <SolidColorBrush x:Key="MaxBorderRight" Color="#FF000000" />
  <SolidColorBrush x:Key="MaxBorderBottom" Color="#FF000000" />
  <SolidColorBrush x:Key="MaxBorderLeft" Color="#FF000000" />
  <SolidColorBrush x:Key="CloseBg" Color="#FFDCDCDC" />
  <SolidColorBrush x:Key="CloseBorderTop" Color="#FF000000" />
  <SolidColorBrush x:Key="CloseBorderRight" Color="#FF000000" />
  <SolidColorBrush x:Key="CloseBorderBottom" Color="#FF000000" />
  <SolidColorBrush x:Key="CloseBorderLeft" Color="#FF000000" />
  <SolidColorBrush x:Key="CloseFg" Color="#FF000000" />
  <LinearGradientBrush x:Key="Desktop" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF8D99A6" Offset="0" />
      <GradientStop Color="#FF6D7885" Offset="0.55" />
      <GradientStop Color="#FF525B66" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <BoxShadows x:Key="RaiseShadow">inset 0 1 0 0 #FFFFFFFF,inset -1 -1 0 0 #FFA4A4A4</BoxShadows>
  <BoxShadows x:Key="RaiseShadowLight">inset 0 1 0 0 #FFFFFFFF,inset -1 -1 0 0 #FFA4A4A4</BoxShadows>
  <BoxShadows x:Key="SunkShadow">inset 1 1 0 0 #FFA8A8A8</BoxShadows>
  <CornerRadius x:Key="ControlRadius">5</CornerRadius>
  <CornerRadius x:Key="WindowRadius">5</CornerRadius>
  <CornerRadius x:Key="WindowButtonRadius">2</CornerRadius>
</ResourceDictionary>
