<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- macOS · Sonoma — generated by .build/gen_themes.py, do not hand-edit -->
  <SolidColorBrush x:Key="Face" Color="#FFF2F2F4" />
  <SolidColorBrush x:Key="Face2" Color="#FFE6E6EA" />
  <SolidColorBrush x:Key="Press" Color="#FFDCDCE2" />
  <SolidColorBrush x:Key="Lite" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Shad" Color="#FFD2D2D8" />
  <SolidColorBrush x:Key="Dark" Color="#FFC2C2C9" />
  <SolidColorBrush x:Key="RaiseBorderTop" Color="#FFD0D0D6" />
  <SolidColorBrush x:Key="RaiseBorderRight" Color="#FFD0D0D6" />
  <SolidColorBrush x:Key="RaiseBorderBottom" Color="#FFD0D0D6" />
  <SolidColorBrush x:Key="RaiseBorderLeft" Color="#FFD0D0D6" />
  <SolidColorBrush x:Key="SunkBorderTop" Color="#FFC9C9D1" />
  <SolidColorBrush x:Key="SunkBorderRight" Color="#FFC9C9D1" />
  <SolidColorBrush x:Key="SunkBorderBottom" Color="#FFC9C9D1" />
  <SolidColorBrush x:Key="SunkBorderLeft" Color="#FFC9C9D1" />
  <SolidColorBrush x:Key="TabBorderTop" Color="#FFD0D0D6" />
  <SolidColorBrush x:Key="TabBorderRight" Color="#FFD0D0D6" />
  <SolidColorBrush x:Key="TabBorderBottom" Color="#FFD0D0D6" />
  <SolidColorBrush x:Key="TabBorderLeft" Color="#FFD0D0D6" />
  <LinearGradientBrush x:Key="TitleBar" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFF7F7F9" Offset="0" />
      <GradientStop Color="#FFE8E8EC" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DialogTitleBar" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFF7F7F9" Offset="0" />
      <GradientStop Color="#FFE8E8EC" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelCaption" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFEEEEF1" Offset="0" />
      <GradientStop Color="#FFE2E2E7" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Selection" Color="#FF0A6CFF" />
  <SolidColorBrush x:Key="Frame" Color="#FFF2F2F4" />
  <SolidColorBrush x:Key="FrameBorderTop" Color="#FFCFCFD6" />
  <SolidColorBrush x:Key="FrameBorderRight" Color="#FFCFCFD6" />
  <SolidColorBrush x:Key="FrameBorderBottom" Color="#FFCFCFD6" />
  <SolidColorBrush x:Key="FrameBorderLeft" Color="#FFCFCFD6" />
  <SolidColorBrush x:Key="TitleBarFg" Color="#FF1D1D1F" />
  <SolidColorBrush x:Key="PanelCaptionFg" Color="#FF3A3A3E" />
  <SolidColorBrush x:Key="WindowButtonFg" Color="#00000000" />
  <SolidColorBrush x:Key="MinBg" Color="#FFFEBC2E" />
  <SolidColorBrush x:Key="MinBorderTop" Color="#FFE0A021" />
  <SolidColorBrush x:Key="MinBorderRight" Color="#FFE0A021" />
  <SolidColorBrush x:Key="MinBorderBottom" Color="#FFE0A021" />
  <SolidColorBrush x:Key="MinBorderLeft" Color="#FFE0A021" />
  <SolidColorBrush x:Key="MaxBg" Color="#FF28C840" />
  <SolidColorBrush x:Key="MaxBorderTop" Color="#FF1EAA35" />
  <SolidColorBrush x:Key="MaxBorderRight" Color="#FF1EAA35" />
  <SolidColorBrush x:Key="MaxBorderBottom" Color="#FF1EAA35" />
  <SolidColorBrush x:Key="MaxBorderLeft" Color="#FF1EAA35" />
  <SolidColorBrush x:Key="CloseBg" Color="#FFFF5F57" />
  <SolidColorBrush x:Key="CloseBorderTop" Color="#FFE0443E" />
  <SolidColorBrush x:Key="CloseBorderRight" Color="#FFE0443E" />
  <SolidColorBrush x:Key="CloseBorderBottom" Color="#FFE0443E" />
  <SolidColorBrush x:Key="CloseBorderLeft" Color="#FFE0443E" />
  <SolidColorBrush x:Key="CloseFg" Color="#00000000" />
  <LinearGradientBrush x:Key="Desktop" StartPoint="32.899%,3.01537%" EndPoint="67.101%,96.9846%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF2B3A6B" Offset="0" />
      <GradientStop Color="#FF5B4A8F" Offset="0.45" />
      <GradientStop Color="#FF8C5C96" Offset="0.75" />
      <GradientStop Color="#FFC98A7A" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <BoxShadows x:Key="RaiseShadow">inset 0 1 0 0 #FFFFFFFF,0 1 1 0 #0F000000</BoxShadows>
  <BoxShadows x:Key="RaiseShadowLight">inset 0 1 0 0 #FFFFFFFF,0 1 1 0 #0D000000</BoxShadows>
  <BoxShadows x:Key="SunkShadow">inset 0 1 2 0 #12000000</BoxShadows>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="WindowRadius">11</CornerRadius>
  <CornerRadius x:Key="WindowButtonRadius">8</CornerRadius>
</ResourceDictionary>
