<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Windows XP · Luna Blue — generated by .build/gen_themes.py, do not hand-edit -->
  <SolidColorBrush x:Key="Face" Color="#FFECE9D8" />
  <LinearGradientBrush x:Key="Face2" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFF8F7EF" Offset="0" />
      <GradientStop Color="#FFE2DFCB" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Press" Color="#FFDCD9C6" />
  <SolidColorBrush x:Key="Lite" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Shad" Color="#FFACA899" />
  <SolidColorBrush x:Key="Dark" Color="#FF8E8B7D" />
  <SolidColorBrush x:Key="RaiseBorderTop" Color="#FF003C74" />
  <SolidColorBrush x:Key="RaiseBorderRight" Color="#FF003C74" />
  <SolidColorBrush x:Key="RaiseBorderBottom" Color="#FF003C74" />
  <SolidColorBrush x:Key="RaiseBorderLeft" Color="#FF003C74" />
  <SolidColorBrush x:Key="SunkBorderTop" Color="#FF7F9DB9" />
  <SolidColorBrush x:Key="SunkBorderRight" Color="#FF7F9DB9" />
  <SolidColorBrush x:Key="SunkBorderBottom" Color="#FF7F9DB9" />
  <SolidColorBrush x:Key="SunkBorderLeft" Color="#FF7F9DB9" />
  <SolidColorBrush x:Key="TabBorderTop" Color="#FF003C74" />
  <SolidColorBrush x:Key="TabBorderRight" Color="#FF003C74" />
  <SolidColorBrush x:Key="TabBorderBottom" Color="#FF003C74" />
  <SolidColorBrush x:Key="TabBorderLeft" Color="#FF003C74" />
  <LinearGradientBrush x:Key="TitleBar" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF1A86EC" Offset="0" />
      <GradientStop Color="#FF4BA6F8" Offset="0.07" />
      <GradientStop Color="#FF1273E2" Offset="0.34" />
      <GradientStop Color="#FF0A5CD0" Offset="0.72" />
      <GradientStop Color="#FF1272E0" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DialogTitleBar" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF1A86EC" Offset="0" />
      <GradientStop Color="#FF4BA6F8" Offset="0.07" />
      <GradientStop Color="#FF1273E2" Offset="0.34" />
      <GradientStop Color="#FF0A5CD0" Offset="0.72" />
      <GradientStop Color="#FF1272E0" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelCaption" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF82ABEC" Offset="0" />
      <GradientStop Color="#FF4877C9" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Selection" Color="#FF316AC5" />
  <SolidColorBrush x:Key="Frame" Color="#FF0A5CD0" />
  <SolidColorBrush x:Key="FrameBorderTop" Color="#FF0A4BB0" />
  <SolidColorBrush x:Key="FrameBorderRight" Color="#FF0A4BB0" />
  <SolidColorBrush x:Key="FrameBorderBottom" Color="#FF0A4BB0" />
  <SolidColorBrush x:Key="FrameBorderLeft" Color="#FF0A4BB0" />
  <SolidColorBrush x:Key="TitleBarFg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PanelCaptionFg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="WindowButtonFg" Color="#FFFFFFFF" />
  <LinearGradientBrush x:Key="MinBg" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF7FB2EF" Offset="0" />
      <GradientStop Color="#FF2B6FD0" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="MinBorderTop" Color="#FF1D55A8" />
  <SolidColorBrush x:Key="MinBorderRight" Color="#FF1D55A8" />
  <SolidColorBrush x:Key="MinBorderBottom" Color="#FF1D55A8" />
  <SolidColorBrush x:Key="MinBorderLeft" Color="#FF1D55A8" />
  <LinearGradientBrush x:Key="MaxBg" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF7FB2EF" Offset="0" />
      <GradientStop Color="#FF2B6FD0" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="MaxBorderTop" Color="#FF1D55A8" />
  <SolidColorBrush x:Key="MaxBorderRight" Color="#FF1D55A8" />
  <SolidColorBrush x:Key="MaxBorderBottom" Color="#FF1D55A8" />
  <SolidColorBrush x:Key="MaxBorderLeft" Color="#FF1D55A8" />
  <LinearGradientBrush x:Key="CloseBg" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFF4977F" Offset="0" />
      <GradientStop Color="#FFCF4326" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CloseBorderTop" Color="#FF9C3417" />
  <SolidColorBrush x:Key="CloseBorderRight" Color="#FF9C3417" />
  <SolidColorBrush x:Key="CloseBorderBottom" Color="#FF9C3417" />
  <SolidColorBrush x:Key="CloseBorderLeft" Color="#FF9C3417" />
  <SolidColorBrush x:Key="CloseFg" Color="#FFFFFFFF" />
  <LinearGradientBrush x:Key="Desktop" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF2F6FC4" Offset="0" />
      <GradientStop Color="#FF5B9DE0" Offset="0.55" />
      <GradientStop Color="#FF8CC3E8" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <BoxShadows x:Key="RaiseShadow">inset 0 1 0 0 #FFFFFFFF,inset 0 -7 7 -7 #21000000</BoxShadows>
  <BoxShadows x:Key="RaiseShadowLight">inset 0 1 0 0 #FFFFFFFF</BoxShadows>
  <BoxShadows x:Key="SunkShadow">0 0 0 0 #00000000</BoxShadows>
  <CornerRadius x:Key="ControlRadius">3</CornerRadius>
  <CornerRadius x:Key="WindowRadius">8</CornerRadius>
  <CornerRadius x:Key="WindowButtonRadius">3</CornerRadius>
</ResourceDictionary>
