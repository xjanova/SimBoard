  <SolidColorBrush x:Key="CloseBorderBottom" Color="#FF9C3417" />
  <SolidColorBrush x:Key="CloseBorderLeft" Color="#FF9C3417" />
  <SolidColorBrush x:Key="CloseFg" Color="#FFFFFFFF" />
  <LinearGradientBrush x:Key="Desktop" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF4A5361" Offset="0" />
      <GradientStop Color="#FF737D8C" Offset="0.6" />
      <GradientStop Color="#FF9AA3B0" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <BoxShadows x:Key="RaiseShadow">inset 0 1 0 0 #FFFFFFFF,inset 0 -7 7 -7 #21000000</BoxShadows>
  <BoxShadows x:Key="RaiseShadowLight">inset 0 1 0 0 #FFFFFFFF</BoxShadows>
  <BoxShadows x:Key="SunkShadow">0 0 0 0 #00000000</BoxShadows>
  <CornerRadius x:Key="ControlRadius">3</CornerRadius>
  <CornerRadius x:Key="WindowRadius">8</CornerRadius>
  <CornerRadius x:Key="WindowButtonRadius">3</CornerRadius>
</ResourceDictionary>
