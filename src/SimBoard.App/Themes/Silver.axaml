<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Windows XP · Silver — generated by .build/gen_themes.py, do not hand-edit -->
  <SolidColorBrush x:Key="Face" Color="#FFE9E9EE" />
  <LinearGradientBrush x:Key="Face2" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFFBFBFD" Offset="0" />
      <GradientStop Color="#FFDCDCE4" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Press" Color="#FFD6D6DE" />
  <SolidColorBrush x:Key="Lite" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Shad" Color="#FFA8A8B2" />
  <SolidColorBrush x:Key="Dark" Color="#FF8B8B96" />
  <SolidColorBrush x:Key="RaiseBorderTop" Color="#FF7B7B88" />
  <SolidColorBrush x:Key="RaiseBorderRight" Color="#FF7B7B88" />
  <SolidColorBrush x:Key="RaiseBorderBottom" Color="#FF7B7B88" />
  <SolidColorBrush x:Key="RaiseBorderLeft" Color="#FF7B7B88" />
  <SolidColorBrush x:Key="SunkBorderTop" Color="#FF9A9AA6" />
  <SolidColorBrush x:Key="SunkBorderRight" Color="#FF9A9AA6" />
  <SolidColorBrush x:Key="SunkBorderBottom" Color="#FF9A9AA6" />
  <SolidColorBrush x:Key="SunkBorderLeft" Color="#FF9A9AA6" />
  <SolidColorBrush x:Key="TabBorderTop" Color="#FF7B7B88" />
  <SolidColorBrush x:Key="TabBorderRight" Color="#FF7B7B88" />
  <SolidColorBrush x:Key="TabBorderBottom" Color="#FF7B7B88" />
  <SolidColorBrush x:Key="TabBorderLeft" Color="#FF7B7B88" />
  <LinearGradientBrush x:Key="TitleBar" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF9C9CB2" Offset="0" />
      <GradientStop Color="#FFC2C2D2" Offset="0.08" />
      <GradientStop Color="#FF8E8EA6" Offset="0.38" />
      <GradientStop Color="#FF6E6E86" Offset="0.76" />
      <GradientStop Color="#FF9494AC" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DialogTitleBar" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FF9C9CB2" Offset="0" />
      <GradientStop Color="#FFC2C2D2" Offset="0.08" />
      <GradientStop Color="#FF8E8EA6" Offset="0.38" />
      <GradientStop Color="#FF6E6E86" Offset="0.76" />
      <GradientStop Color="#FF9494AC" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelCaption" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFB0B0C2" Offset="0" />
      <GradientStop Color="#FF7E7E94" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Selection" Color="#FF5C6EA8" />
  <SolidColorBrush x:Key="Frame" Color="#FF8B8B9A" />
  <SolidColorBrush x:Key="FrameBorderTop" Color="#FF6F6F7D" />
  <SolidColorBrush x:Key="FrameBorderRight" Color="#FF6F6F7D" />
  <SolidColorBrush x:Key="FrameBorderBottom" Color="#FF6F6F7D" />
  <SolidColorBrush x:Key="FrameBorderLeft" Color="#FF6F6F7D" />
  <SolidColorBrush x:Key="TitleBarFg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PanelCaptionFg" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="WindowButtonFg" Color="#FFFFFFFF" />
  <LinearGradientBrush x:Key="MinBg" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFC8C8D6" Offset="0" />
      <GradientStop Color="#FF8E8EA2" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="MinBorderTop" Color="#FF75758A" />
  <SolidColorBrush x:Key="MinBorderRight" Color="#FF75758A" />
  <SolidColorBrush x:Key="MinBorderBottom" Color="#FF75758A" />
  <SolidColorBrush x:Key="MinBorderLeft" Color="#FF75758A" />
  <LinearGradientBrush x:Key="MaxBg" StartPoint="50%,0%" EndPoint="50%,100%">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#FFC8C8D6" Offset="0" />
      <GradientStop Color="#FF8E8EA2" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="MaxBorderTop" Color="#FF75758A" />
  <SolidColorBrush x:Key="MaxBorderRight" Color="#FF75758A" />
  <SolidColorBrush x:Key="MaxBorderBottom" Color="#FF75758A" />
  <SolidColorBrush x:Key="MaxBorderLeft" Color="#FF75758A" />
